+                    a |= v;
+                    p = nz(p, a);
+                }
+                AND => {
+                    a &= v;
+                    p = nz(p, a);
+                }
+                EOR => {
+                    a ^= v;
+                    p = nz(p, a);
+                }
+                ADC | SBC => {
