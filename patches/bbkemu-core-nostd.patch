+                }
+                LDA => {
+                    a = v;
+                    p = nz(p, a);
+                }
+                LDX => {
+                    x = v;
+                    p = nz(p, x);
+                }
+                LDY => {
+                    y = v;
+                    p = nz(p, y);
+                }
+                _ => {
+                    // BIT
+                    p = (p & !(Z | V | N)) | (v & (N | V)) | if a & v == 0 { Z } else { 0 };
+                }
+            }
