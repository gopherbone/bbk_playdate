+            let v = if mode == M_ACC { a } else { m.get_byte(ea) };
+            let (r, carry) = match kind {
+                ASL => (v << 1, v >> 7),
+                LSR => (v >> 1, v & 1),
+                ROL => ((v << 1) | (p & C), v >> 7),
+                ROR => ((v >> 1) | ((p & C) << 7), v & 1),
+                INC => (v.wrapping_add(1), p & C),
+                _ => (v.wrapping_sub(1), p & C),
+            };
