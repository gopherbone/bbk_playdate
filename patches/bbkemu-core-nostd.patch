+// Encoded by hand in bincode 1's default layout (little endian, fixed-width
+// integers, u64 length prefixes) so states stay interchangeable with std builds.
 impl SaveState {
     /// Serialize to bytes
     pub fn to_bytes(&self) -> Vec<u8> {
-        bincode::serialize(self).unwrap_or_default()
+        let mut out = Vec::with_capacity(self.ram.len() + self.flash.len() + 64);
+        put_bytes(&mut out, &self.ram);
+        put_bytes(&mut out, &self.flash);
+        out.extend_from_slice(&self.cpu.pc.to_le_bytes());
+        out.extend_from_slice(&[self.cpu.sp, self.cpu.a, self.cpu.x, self.cpu.y, self.cpu.status]);
+        out.extend_from_slice(&self.cpu.cycles.to_le_bytes());
+        out.extend_from_slice(&(self.bank_switch.banks.len() as u64).to_le_bytes());
+        for bank in &self.bank_switch.banks {
+            out.extend_from_slice(&bank.to_le_bytes());
+        }
+        out.push(self.bank_switch.selected);
+        out.extend_from_slice(&self.bank_sys_d.to_le_bytes());
+        out.push(self.flash_cmd);
+        out.push(self.flash_cycles);
+        out
     }
 
     /// Deserialize from bytes
     pub fn from_bytes(data: &[u8]) -> Result<Self> {
-        Ok(bincode::deserialize(data)?)
+        let mut r = Reader(data);
+        let ram = r.bytes()?;
+        let flash = r.bytes()?;
+        let cpu = CpuState {
+            pc: r.u16()?,
+            sp: r.u8()?,
+            a: r.u8()?,
+            x: r.u8()?,
+            y: r.u8()?,
+            status: r.u8()?,
+            cycles: r.u64()?,
+        };
+        let count = r.len()?;
+        let mut banks = Vec::with_capacity(count.min(64));
+        for _ in 0..count {
+            banks.push(r.u32()?);
+        }
+        let bank_switch = BankState {
+            banks,
+            selected: r.u8()?,
+        };
+        Ok(Self {
+            ram,
+            flash,
+            cpu,
+            bank_switch,
+            bank_sys_d: r.u16()?,
+            flash_cmd: r.u8()?,
+            flash_cycles: r.u8()?,
+        })
     }
 }
+
+fn put_bytes(out: &mut Vec<u8>, bytes: &[u8]) {
+    out.extend_from_slice(&(bytes.len() as u64).to_le_bytes());
+    out.extend_from_slice(bytes);
+}
+
+struct Reader<'a>(&'a [u8]);
+
+impl Reader<'_> {
+    fn take<const N: usize>(&mut self) -> Result<[u8; N]> {
+        if self.0.len() < N {
+            bail!("save state is truncated");
+        }
+        let (head, rest) = self.0.split_at(N);
+        self.0 = rest;
+        Ok(head.try_into().unwrap())
+    }
+
+    fn u8(&mut self) -> Result<u8> {
+        Ok(self.take::<1>()?[0])
+    }
+
+    fn u16(&mut self) -> Result<u16> {
+        Ok(u16::from_le_bytes(self.take()?))
+    }
+
+    fn u32(&mut self) -> Result<u32> {
+        Ok(u32::from_le_bytes(self.take()?))
+    }
+
+    fn u64(&mut self) -> Result<u64> {
+        Ok(u64::from_le_bytes(self.take()?))
+    }
+
+    fn len(&mut self) -> Result<usize> {
+        let n = self.u64()?;
+        if n > self.0.len() as u64 {
+            bail!("save state is truncated");
+        }
+        Ok(n as usize)
+    }
+
+    fn bytes(&mut self) -> Result<Vec<u8>> {
+        let n = self.len()?;
+        let (head, rest) = self.0.split_at(n);
+        self.0 = rest;
+        Ok(head.to_vec())
+    }
+}
