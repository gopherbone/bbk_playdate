+#[inline(always)]
+pub fn step(r: &mut Regs, m: &mut Memory) -> Option<u32> {
+    let pc = r.pc;
+    if !(0x0100..=0xFFFC).contains(&pc) {
+        return None;
+    }
+    let e = TABLE[m.read(pc) as usize];
