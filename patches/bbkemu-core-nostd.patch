+//! Minimal error type standing in for `anyhow` in `no_std` builds.
+
+use alloc::string::String;
+use core::fmt;
+
+#[derive(Debug)]
+pub struct Error(pub String);
+
+impl fmt::Display for Error {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(&self.0)
+    }
+}
+
+pub type Result<T> = core::result::Result<T, Error>;
+
+#[macro_export]
+macro_rules! bail {
+    ($($arg:tt)*) => {
+        return Err($crate::error::Error(alloc::format!($($arg)*)))
+    };
+}
